<div class="grid md:grid-cols-2 grid-cols-1 md:grid-rows-1 grid-rows-2 justify-center items-center gap-6 relative">
    <div class="h-full">
        <form name="contact" class="my-8 shadow-none !p-0 !m-0" action="" netlify>
            <div class="grid grid-cols-1 gap-0">
                <label class="text-white font-normal pb-1" for="full_name">Full Name*</label>
                <input class="text-white p-3 rounded-full text-opacity-80 border-white border-2 bg-transparent" required type="text" name="full_name" id="full_name">
                <label class="text-white pt-10 font-normal pb-1" for="email">Email*</label>
                <input class="text-white p-3 rounded-full text-opacity-80 border-white border-2 bg-transparent" required type="email" name="email" id="email">
                <label class="text-white pt-10 font-normal pb-1" for="message">Message*</label>
                <textarea class="text-white p-3 rounded-[45px] text-opacity-80 border-white border-2 bg-transparent" required name="message" id="message" cols="60" rows="8"></textarea>
                <input  type="submit" value="submit" class="btn text-center mx-auto px-8 bg-red" />
            </div>
        </form>
    </div>
    <div class="h-full bg-purple rounded-[45px] relative overflow-visible z-10">
